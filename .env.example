# =============================================================================
# Шаблон конфигурации. Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env
# .env в git не попадает (см. .gitignore). Секреты никогда не коммитим.
# Один .env в корне используют все процессы: api, worker и web.
# =============================================================================


# ---------------------------------------------------------------------------
# Circle (Developer-Controlled Wallets, testnet)
# ---------------------------------------------------------------------------

# Базовый адрес Circle API. Указывается БЕЗ завершающего "/".
# Testnet и mainnet живут на одном хосте; окружение определяет префикс API key.
CIRCLE_BASE_URL=https://api.circle.com

# API key формата TEST_API_KEY:<id>:<secret>. Нужен именно TEST-ключ: он работает только с тестнетами.
# Где взять: https://console.circle.com → Keys → Create a key → API key → Standard Key.
# Документация: https://developers.circle.com/api-reference/keys
CIRCLE_API_KEY=TEST_API_KEY:replace-me:replace-me

# Entity secret: 32 случайных байта в hex (64 символа). Circle его не хранит, только вы.
# 1) Сгенерировать:  openssl rand -hex 32
# 2) Зарегистрировать в Circle по инструкции:
#    https://developers.circle.com/wallets/dev-controlled/register-entity-secret
#    (Console: https://console.circle.com/wallets/dev/configurator/entity-secret).
#    На фазе 2 появится вспомогательный скрипт регистрации.
# 3) Recovery file, который выдаст Circle, сохраните ВНЕ репозитория: он скачивается один раз.
CIRCLE_ENTITY_SECRET=replace-with-64-hex-chars

# Сеть, в которой создаются кошельки.
CIRCLE_BLOCKCHAIN=BASE-SEPOLIA

# ID wallet set и treasury-кошелька (общий hot wallet, куда сметаются депозиты).
# Вручную не заполняются: их создаст и выведет скрипт bootstrap (появится на фазе 2).
CIRCLE_WALLET_SET_ID=
CIRCLE_TREASURY_WALLET_ID=


# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------

# Публичный HTTPS-адрес API, на который Circle шлёт вебхуки. Локально это URL cloudflared quick tunnel:
#   cloudflared tunnel --url http://localhost:4000   →   https://<random>.trycloudflare.com
# Нужен только скрипту, который создаёт или обновляет подписку в Circle. Сам рантайм его не читает.
# У quick tunnel адрес меняется после каждого перезапуска, и подписку тогда нужно пересоздать.
PUBLIC_API_URL=


# ---------------------------------------------------------------------------
# База данных (Supabase Postgres)
# ---------------------------------------------------------------------------

# Строка подключения через Supavisor в SESSION mode (порт 5432).
# Почему не direct connection: на free tier он доступен только по IPv6.
# Почему не transaction mode (6543): там не работают LISTEN/NOTIFY и prepared statements.
# Где взять: Supabase Dashboard → ваш проект → кнопка "Connect" → вкладка/секция "Session pooler" → URI.
# Пароль задаётся при создании проекта (сбросить: Project Settings → Database → Reset database password).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Размер пула соединений на каждый процесс (api, worker). В session mode каждое клиентское соединение
# занимает отдельное серверное, а пул pooler'а на free tier маленький. Держим значение небольшим.
DB_POOL_MAX=3


# ---------------------------------------------------------------------------
# API (Express) и worker
# ---------------------------------------------------------------------------

API_PORT=4000
# Origin фронтенда: для CORS и SSE.
CORS_ORIGIN=http://localhost:3000
# trace | debug | info | warn | error
LOG_LEVEL=info


# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------

# Адрес API для браузера. Префикс NEXT_PUBLIC_ означает, что значение попадёт в клиентский бандл,
# поэтому здесь не должно быть секретов.
NEXT_PUBLIC_API_URL=http://localhost:4000
